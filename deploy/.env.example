# Скопируйте в .env и заполните. Пароли — длинные случайные строки (openssl rand -base64 24).
# Домена пока нет: с localhost Caddy выдаёт самоподписанный сертификат. С настоящим именем,
# направленным на сервер, сертификат Let's Encrypt выпустится сам.
PIKNI_DOMAIN=localhost
PIKNI_ENV=demo
PIKNI_VERSION=latest

POSTGRES_PASSWORD=change-me
PIKNI_OWNER_PASSWORD=change-me
PIKNI_APP_PASSWORD=change-me
GOVSIM_PASSWORD=change-me

PIKNI_BACKUP_DIR=/var/backups/pikni
