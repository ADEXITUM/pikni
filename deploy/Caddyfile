# Домен задаёт PIKNI_DOMAIN: для настоящего имени Caddy сам получит сертификат Let's Encrypt.
# Пока домена нет — localhost с самоподписанным сертификатом Caddy.
{$PIKNI_DOMAIN:localhost} {
	encode zstd gzip

	# API и WebSocket событий реального времени — на два экземпляра. Упавший экземпляр Caddy
	# исключает по проверке готовности, запрос повторяет на втором (п. 4.4.3).
	handle /api/* {
		reverse_proxy api:8080 api-2:8080 {
			lb_policy round_robin
			lb_try_duration 5s
			health_uri /readyz
			health_interval 5s
		}
	}

	# Касса — отдельное приложение со своим сервис-воркером.
	handle_path /pos/* {
		root * /srv/pos
		try_files {path} /index.html
		file_server
	}

	handle {
		root * /srv/staff
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		Permissions-Policy "camera=(self), microphone=()"
	}
}
